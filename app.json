{
  "expo": {
    "name": "Saldio",
    "slug": "saldio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Saldio",
      "description": "Catatan keuangan pribadi — aset, emas, dan transaksi dalam satu tempat.",
      "lang": "id",
      "themeColor": "#E6F4FE"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Saldio butuh akses galeri untuk melampirkan foto struk.",
          "cameraPermission": "Saldio butuh akses kamera untuk memfoto struk.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
